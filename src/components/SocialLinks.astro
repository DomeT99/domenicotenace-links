<style>
  .social-links {
    display: flex;
    justify-content: center;
    gap: 1.2rem;
    margin-bottom: 2rem;
  }

  .social-icon {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.05);
    color: var(--text, #eff1f5);
    transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
    border: 1px solid rgba(255, 255, 255, 0.08);
  }

  .social-icon:hover {
    background: rgba(250, 137, 45, 0.15);
    color: var(--button, #fa892d);
    transform: translateY(-3px);
    border-color: rgba(250, 137, 45, 0.4);
  }

  .social-icon svg {
    transition: transform 0.3s ease;
  }

  .social-icon:hover svg {
    transform: scale(1.1);
  }
</style>
